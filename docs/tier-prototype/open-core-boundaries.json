{
  "schemaVersion": 1,
  "purpose": "Source ownership contract for the public Free/shared-core repository after Commercial extraction",
  "defaultOwner": "public",
  "allowedDependencies": {
    "public": ["public"],
    "pro": ["public", "pro"],
    "team": ["public", "pro", "team"],
    "demo": ["public", "pro", "team", "demo"]
  },
  "ownershipRules": [
    { "kind": "file", "path": "src/index.ts", "owner": "public" },
    { "kind": "file", "path": "src/control-center/contract.ts", "owner": "public" },
    { "kind": "file", "path": "src/control-center/host.ts", "owner": "public" },
    { "kind": "file", "path": "src/control-center/server.ts", "owner": "public" },
    { "kind": "file", "path": "src/npm-scripts/control-center.ts", "owner": "public" }
  ],
  "requiredPublicContracts": [
    "src/entitlements/capabilities.ts",
    "src/entitlements/free-provider.ts",
    "src/runtime/policy-hook.ts",
    "src/runtime/runtime-services.ts",
    "src/commercial-contract.ts",
    "src/free-index.ts",
    "src/run-server.ts",
    "src/control-center-contract.ts"
  ]
}
